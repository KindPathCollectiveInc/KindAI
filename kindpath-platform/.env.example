# Copy this file to .env.local and fill in your Supabase project values.
# Never commit .env.local — it is gitignored.

# Supabase project URL and anon (public) key — found in Project Settings > API.
# The anon key is safe to expose in the browser; RLS policies do the real
# access control. Never put the service_role key in any client-side file.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
