{
  "name": "kindis",
  "productName": "KiNDIS",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder --mac"
  },
  "build": {
    "appId": "ai.kindpath.kindis",
    "productName": "KiNDIS",
    "mac": {
      "category": "public.app-category.business",
      "target": [{ "target": "dir", "arch": ["x64"] }]
    },
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "node_modules/**/*"
    ]
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwind-merge": "^3.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.1",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.8.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.2.1",
    "typescript": "~5.9.3",
    "vite": "^7.3.1"
  }
}
