# Copy to .env and fill in. .env is gitignored — never commit real values.

# Interact2 (D2L Brightspace) personal calendar feed URL(s).
# Get yours from Interact2 -> Calendar -> Subscribe / Get iCal feed.
# CSU's "All Subjects" feed doesn't reliably include every enrolled unit —
# if a unit is missing, open that unit's own calendar in Interact2 and grab
# its feed link too (it'll have a ?feedOU=... parameter). Separate multiple
# URLs with whitespace or commas. Each contains an auth token in the query
# string — treat it as a secret.
CSU_ICS_FEED_URLS=
